# ---------------------------------------------------------------------------
# NoteSphere environment variables
#
# Copy this file to .env for local XAMPP development:
#   copy .env.example .env
#
# On Vercel, add the same values in Project Settings > Environment Variables.
# Never commit .env or any real password / API secret.
# ---------------------------------------------------------------------------

# Database (Aiven MySQL)
DB_HOST=notesphere-xjallorina-16dc.g.aivencloud.com
DB_PORT=27295
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASS=replace-with-your-aiven-password

# Aiven requires TLS. Leave DB_SSL=1 for remote hosts.
DB_SSL=1
# DB_SSL_CA=includes/certs/aiven-ca.pem
# DB_SSL_CA_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
DB_SSL_VERIFY=1

# Store PHP sessions in MySQL (required on Vercel).
DB_SESSIONS=1
SESSION_LIFETIME=43200

APP_TIMEZONE=Asia/Manila
APP_DEBUG=0

# Cloudinary - browser uploads go directly to Cloudinary so large files never
# hit Vercel's 4.5 MB request-body limit. Create an UNSIGNED upload preset in
# Cloudinary > Settings > Upload and put its name below.
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_UPLOAD_PRESET=replace-with-your-unsigned-preset
CLOUDINARY_FOLDER=notesphere

# Gmail SMTP (PHPMailer)
MAIL_USERNAME=your-email@gmail.com
MAIL_APP_PASSWORD=your-gmail-app-password

# Optional Node push server. On Vercel, host it separately and use its public
# HTTPS URL. Locally the default http://127.0.0.1:4000 is used.
PUSH_SERVER_URL=http://127.0.0.1:4000
